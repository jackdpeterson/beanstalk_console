{
    "name": "ptrofimov/beanstalk_console",
    "description": "Admin console for Beanstalk queue server",
    "version": "1.7.21",
    "keywords": ["beanstalk", "beanstalkd", "queue", "console", "gui", "admin", "web admin", "monitoring", "stats", "interface", "php"],
    "type": "project",
    "authors": [
        {
            "name": "Petr Trofimov"
        },
        {
            "name": "Sergey Lysenko"
        },
        {
            "name": "Pentium10"
        }
    ],
    "scripts": {
        "test": "phpunit --colors=always",
        "cs": "phpcs --standard=PSR12 --extensions=php src tests",
        "cs-fix": "phpcbf --standard=PSR12 --extensions=php src tests",
        "phpstan": "phpstan analyse --ansi --memory-limit 512M --no-progress src",
        "phpstan-baseline": "phpstan analyse --ansi --memory-limit 512M --no-progress --generate-baseline src"
    },
    "support": {
        "issues": "https://github.com/ptrofimov/beanstalk_console/issues"
    },
    "autoload": {
        "psr-4": {
            "Ptrofimov\\BeanstalkConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "pda/pheanstalk": "^6.0.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^2.1.4"

    }
}
